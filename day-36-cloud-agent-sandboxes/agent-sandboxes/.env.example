# Names only. Copy to .env (git-ignored) or export in your shell. Never commit values.
# The offline path (python run_mock.py, pytest) needs none of these.

# Required for every real run: explicit opt-in, because real runs create billable sandboxes.
SANDBOX_ALLOW_REAL=

# Optional: clone a real repository instead of using task/sample-repo (a public https URL; the task's network allow-list must cover its host).
SANDBOX_TASK_REPO_URL=

# --- Vercel Sandbox (vercel/) ---
# Either the OIDC token (after `vercel link` and `vercel env pull`; expires after 12 hours) ...
VERCEL_OIDC_TOKEN=
# ... or an access token with explicit project scope:
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=

# --- Modal Sandboxes (modal/) --- (`modal setup` writes a profile file instead; the runner accepts either)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Optional: "gvisor" or "vm" (Modal's runtime option)
MODAL_SANDBOX_RUNTIME=

# --- Daytona (daytona/) ---
DAYTONA_API_KEY=
# Optional
DAYTONA_API_URL=
DAYTONA_TARGET=
