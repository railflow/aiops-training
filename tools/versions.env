# Tool and image versions used by this course.
#
# These were chosen from documentation and release notes; they have NOT all been
# run end-to-end together. Before you start, check each project's releases page.
# After your first successful run, record what you actually got:
#     docker image inspect <image> --format '{{index .RepoDigests 0}}'
# Entries ending in "latest" float; pin them once things work.
#
# Source this file in bash if you want the values as shell variables:
#     set -a; source tools/versions.env; set +a

# Base images
PYTHON_IMAGE=python:3.12-slim
JDK_IMAGE=eclipse-temurin:21-jdk
JRE_IMAGE=eclipse-temurin:21-jre
MAVEN_IMAGE=maven:3.9-eclipse-temurin-21
GO_IMAGE=golang:1.23
ALPINE_IMAGE=alpine:3.20
BUSYBOX_IMAGE=busybox:1.36

# Cluster and Kubernetes add-ons
KIND_VERSION=v0.27.0
CALICO_VERSION=v3.29.1
INGRESS_NGINX_VERSION=controller-v1.12.0
FLUX_NOTE="use the latest flux CLI; it installs matching controllers"
FLAGGER_CHART=pinned below as FLAGGER_CHART_VERSION

# Data services (Day 4)
POSTGRES_IMAGE=postgres:16
MINIO_IMAGE=quay.io/minio/minio:latest
NATS_IMAGE=nats:2.10-alpine
NATSBOX_IMAGE=natsio/nats-box:latest
APPWRITE_VERSION=2.7.1

# Security and supply chain (Day 8)
TRIVY_IMAGE=aquasec/trivy:0.58.1
SYFT_IMAGE=anchore/syft:v1.18.1
COSIGN_VERSION=v2.4.1

# Platform (Day 10)
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:11-rootless
FORGEJO_RUNNER_IMAGE=code.forgejo.org/forgejo/runner:latest
NEXUS_IMAGE=sonatype/nexus3:latest

# CI at scale and policy (Days 13-15)
BUILDKIT_IMAGE=moby/buildkit:v0.18.2-rootless
OPA_IMAGE=openpolicyagent/opa:1.0.0
OPA_VERSION=1.0.0

# Progressive delivery (Day 22)
PODINFO_VERSION=6.7.1
PODINFO_VERSION_NEW=6.8.0

# Traefik (Day 7). Run `helm search repo traefik/traefik` and record the CHART VERSION you installed.
TRAEFIK_CHART_NOTE="pin the chart version printed by: helm list -n traefik (CHART column)"
MKCERT_NOTE="install with winget (FiloSottile.mkcert), choco (mkcert), or brew (mkcert)"

# Platform notes (Day 10): pin these once you have pulled them. The runner image tag and Nexus tag are not verified.
FORGEJO_RUNNER_TAG_NOTE="check tags at https://code.forgejo.org/forgejo/-/packages/container/runner"
NEXUS_TAG_NOTE="replace :latest in day-10-local-platform/platform/nexus.yaml with the tag you pulled (docker image ls sonatype/nexus3)"
DIND_IMAGE=docker:27-dind

# Secrets detection (Day 14). Unverified: confirm against the release pages.
GITLEAKS_VERSION=8.21.2

# Secrets management (Day 16). Chart versions are not pinned here: record what helm list shows.
OPENBAO_CHART_NOTE="helm repo add openbao https://openbao.github.io/openbao-helm; helm search repo openbao/openbao"
ESO_CHART_NOTE="helm repo add external-secrets https://charts.external-secrets.io; helm search repo external-secrets/external-secrets"

# Observability (Day 17). Images and chart are NOT verified together: record what you actually ran.
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
OTEL_COLLECTOR_CONTRIB_NOTE="chart: open-telemetry/opentelemetry-collector (helm search repo); image: otel/opentelemetry-collector-contrib, tag = chart appVersion unless you set image.tag"
OTEL_COLLECTOR_CHART_REPO="https://open-telemetry.github.io/opentelemetry-helm-charts"
TELEMETRYGEN_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:v0.115.0
OTEL_PY_SDK=1.27.0
OTEL_PY_INSTRUMENTATION=0.48b0
SHOP_IMAGE=shop-observability:1.0

# Monitoring (Day 18). Chart versions below are what `helm search repo` returned on the authoring Mac on 2026-11-05
# and what the values files were rendered against with `helm template` (not installed on a cluster).
OTEL_COLLECTOR_CHART_VERSION=0.178.2        # app version 0.163.2
METRICS_SERVER_CHART_VERSION=3.14.0         # app version 0.9.0
GRAFANA_CHART_REPO=https://grafana-community.github.io/helm-charts   # grafana/grafana is deprecated and migrating here
GRAFANA_CHART_VERSION=14.3.1                # chart grafana-community/grafana, app version 13.3.0
OPENBAO_CHART_VERSION=0.30.6                # app version 2.7.2
EXTERNAL_SECRETS_CHART_VERSION=2.14.0
K6_IMAGE=grafana/k6:latest                  # pin to a tag once you have run it: docker image inspect grafana/k6

# Dashboards (Day 19)
GRAFANA_CLICKHOUSE_PLUGIN="grafana-clickhouse-datasource (version is whatever the plugin catalogue serves; record it from Administration > Plugins)"
K6_IN_CLUSTER_IMAGE=grafana/k6:latest       # pin once run

# Alerting (Day 20). Keep chart from https://keephq.github.io/helm-charts : `helm search repo keephq/keep`.
# Chart 0.1.97 renders app images 0.54.3 (the Keep GitHub release page showed v0.55.0 on 2026-11-05; the chart lagged).
KEEP_CHART_VERSION=0.1.97
KEEP_APP_VERSION=0.54.3
# The chart's MySQL defaults to the floating tag "latest"; day-20-alerting-with-keep/alerting/keep/values-keep.yaml pins it to 8.4.
KEEP_MYSQL_TAG=8.4
MAILPIT_IMAGE=axllent/mailpit:v1.33.0
ECHO_SINK_IMAGE=mendhak/http-https-echo:43

# Is my app up and OK (Day 21). Gatus release v5.38.0 was current on 2026-11-05; the TwiN helm chart (twin/gatus 1.5.0) ships app v5.34.0.
GATUS_IMAGE=ghcr.io/twin/gatus:v5.38.0
# Day 21: the hello apps gained /readyz and /version; rebuilt tags are used by day-21-is-my-app-up-gatus/gatus/apps-v2.yaml
HELLO_PY_IMAGE=hello-py-app:1.2
HELLO_JAVA_IMAGE=hello-java-app:1.2
HELLO_GO_IMAGE=hello-go-api:1.1

# Day 22: GitOps and progressive delivery
FLUX_VERSION=v2.10.0
FLUX_INSTALL_URL=https://github.com/fluxcd/flux2/releases/download/v2.10.0/install.yaml
FLAGGER_CHART_VERSION=1.45.0
FLAGGER_LOADTESTER_CHART_VERSION=0.39.0
# Flagger's bundled Prometheus renders as prom/prometheus:v2.41.0 in chart 1.45.0: old, noted as a patching item.
TRAEFIK_CHART_VERSION_CHECKED=42.3.0   # app v3.7.17 on 2026-11-05; record the version YOU installed
PODINFO_IMAGE=ghcr.io/stefanprodan/podinfo:6.7.1
PODINFO_IMAGE_NEW=ghcr.io/stefanprodan/podinfo:6.8.0

# Days 23-26 (patching, platform, Appwrite). Read on 2026-11-05.
APPWRITE_CHART_VERSION=2.1.0                 # oci://ghcr.io/appwrite/charts/appwrite (appVersion 2.6.1)
APPWRITE_CHART_APP_VERSION=2.6.1
APPWRITE_DOCKER_VERSION=2.7.1                # appwrite/appwrite image in the Docker installer docs (Day 4)
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48     # MinIO's community repo is archived (checked 2026-11-05)
NATS_IMAGE=nats:2.11-alpine
PLATFORM_POSTGRES_IMAGE=postgres:17-alpine

# Day 27: durable workflows with Temporal. Read on 2026-11-05. Chart 1.8.0 -> server 1.32.2; CLI 1.10.0 bundles server 1.32.2 and UI 2.56.1.
TEMPORAL_CHART_VERSION=1.8.0                 # helm repo add temporal https://go.temporal.io/helm-charts ; chart temporal/temporal
TEMPORAL_SERVER_VERSION=1.32.2               # temporalio/server and temporalio/admin-tools use this tag in the chart
TEMPORAL_UI_VERSION=2.56.1                   # temporalio/ui
TEMPORAL_CLI_VERSION=1.10.0                  # github.com/temporalio/cli ; image temporalio/temporal:1.10.0 (dev server)
TEMPORAL_PY_SDK_VERSION=1.35.0               # PyPI: temporalio

# --- Capstone (the AI agent army) ---
CAPSTONE_CLICKHOUSE_DB=capstone
DOTNET_CHANNEL=8.0                              # measure image: .NET SDK channel (dotnet-install.sh)
CAPSTONE_JUNIT_JUPITER_VERSION=5.10.2           # generated java repos
CAPSTONE_JACOCO_VERSION=0.8.12

CLAUDE_CODE_VERSION=2.1.278                    # agent image: npm @anthropic-ai/claude-code (flags read from this version's --help)

# --- Day 33: message queues in DevEx (day-33-message-queues-in-devex/mq-devex) ---
# Labs verified live with these binaries (downloaded to /tmp, never installed system-wide); the cluster image is the Day 4 NATS_IMAGE above.
MQ_NATS_SERVER_VERIFIED=2.11.17                 # github.com/nats-io/nats-server release
MQ_NATS_CLI_VERIFIED=0.5.1                      # github.com/nats-io/natscli release (nats --version)
MQ_NATS_PY_VERSION=2.16.0                       # PyPI nats-py, used by lib/devbus.py
MQ_WORKER_IMAGE=python:3.12-slim                # worker pods pip-install nats-py and pyyaml at start (kind has internet)

# --- Day 34: agent harness (day-34-agent-harness-adk/agent-harness-adk) ---
ADK_VERSION=2.13.0                              # PyPI google-adk; the lab and its tests are pinned to this exactly (2.x deprecates SequentialAgent/LoopAgent/ParallelAgent)
ADK_PYTHON=3.12                                 # what the tests were run with
ADK_GOLANG_IMAGE=golang:1.23                    # used once to vet the Go skeleton; not needed to run the lab

# AI DevEx (Days 29-32): no model ids on purpose; pick them from the gateway at run time
AI_DEVEX_PYTHON=3.12            # what the tests were run with
AI_DEVEX_JEV_MODEL_SEEN=typesafe/jev-1.13   # as shown in OpenRouter docs on 2026-11-05; overridable via JEV_MODEL

# --- Day 35: durable agents with Eve (day-35-durable-agents-eve/durable-agents-eve) ---
# Read from the npm registry and the package's own docs on 2026-11-05. The package says "engines": {"node": ">=24"}.
EVE_VERSION=1.0.0-rc.5                          # npm eve (dist-tag latest); vercel.com/eve labels it "Beta v1.0.0-rc.5"
EVE_AI_SDK_RANGE=^7.0.137                       # eve peer dependency "ai"; the lab resolved ai 7.0.163, zod 4.6.7
EVE_NODE_VERIFIED=24.19.0                       # the Node the live lab was run with (Node 22.13.1 is too old for eve)
EVE_WORKFLOW_SPEC=9                             # Workflow spec version eve 1.0.0-rc.5 creates new runs with (local world)
# Temporal and ADK equivalents reuse the pins above: TEMPORAL_CLI_VERSION, TEMPORAL_PY_SDK_VERSION, ADK_VERSION

# --- Day 36: cloud agent sandboxes (day-36-cloud-agent-sandboxes/agent-sandboxes) ---
# Read from npm / PyPI and the SDKs' own types on 2026-11-05. None of these were run against a live account.
VERCEL_SANDBOX_VERSION=3.9.1                    # npm @vercel/sandbox (Apache-2.0); the TypeScript runner typechecks against these types
MODAL_VERSION=1.6.3                             # PyPI modal; tests/test_sdk_surface.py checks every name the runner uses against it
DAYTONA_VERSION=0.230.0                         # PyPI daytona (the npm package @daytona/sdk is at the same version)
SANDBOX_LAB_NODE=24.19.0                        # Node used for the TypeScript tests (type stripping) and tsc
SANDBOX_LAB_PYTHON=3.12                         # what the Python tests were run with
