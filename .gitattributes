# Let git normalise text files, but pin LF for anything that runs on Linux.
# A script or Dockerfile with CRLF line endings fails inside containers
# with errors like "bad interpreter: /usr/bin/env: No such file or directory".
* text=auto

/build.sh text eol=lf
/tools/kind text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.java text eol=lf
*.go text eol=lf
*.rego text eol=lf
*.md text eol=lf
*.env text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf

# Windows-native scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
