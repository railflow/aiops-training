#!/usr/bin/env bash
# Local safety net: refuse to commit staged changes that contain secrets.
# Install: cp day-14-secrets-detection/secrets/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Skipped with `git commit --no-verify`, so CI must scan again (defense in depth).
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  if [ "${GITLEAKS_REQUIRED:-0}" = "1" ]; then
    echo "pre-commit: gitleaks is required but not installed" >&2
    exit 1
  fi
  echo "pre-commit: gitleaks not installed, skipping secret scan (CI will still scan)" >&2
  exit 0
fi

# Older gitleaks: `gitleaks protect --staged`. Newer (8.19+): `gitleaks git --pre-commit --staged`.
# Run `gitleaks --help` to see which your version supports.
if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner --verbose
else
  gitleaks protect --staged --redact --verbose
fi
