# syntax=docker/dockerfile:1
# Same layering plus a BuildKit cache mount: npm's download cache survives between builds,
# even when the layer itself has to be rebuilt.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev
COPY index.js ./
CMD ["node", "index.js"]
